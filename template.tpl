___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const log = require('logToConsole');
const createQueue = require('createQueue');
const copyFromDataLayer = require('copyFromDataLayer');
const localStorage = require('localStorage');
const generateRandom = require('generateRandom');
const getTimestampMillis = require('getTimestampMillis');
const getType = require('getType');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const makeInteger = require('makeInteger');
const makeTableMap = require('makeTableMap');
const JSON = require('JSON');
const Math = require('Math');
const Object = require('Object');

const MAX_PRODUCTS = 100;
const MAX_STRING = 500;
const STORAGE_KEY = 'mf_checkout_id';
const CHECKOUT_ID_TTL = 24 * 60 * 60 * 1000;

const PRODUCT_SOURCE_KEYS = {
    product_id: ['item_id', 'id', 'sku'],
    name: ['item_name', 'name', 'title'],
    price: ['price'],
    quantity: ['quantity'],
    category: ['item_category', 'category'],
    brand: ['item_brand', 'brand'],
    sku: ['item_variant', 'variant', 'sku'],
    discount: ['discount']
};

const mfq = createQueue('_mfq');
if (!mfq) {
    log('Mouseflow: no access_globals permission for _mfq, tag did not fire.');
    data.gtmOnFailure();
    return;
}

function debug(message, value) {
    if (data.enableLogging) log('Mouseflow: ' + message, value);
}

function isSet(value) {
    const type = getType(value);
    return type !== 'undefined' && type !== 'null' && value !== '';
}

function pick(explicit, fallback) {
    return isSet(explicit) ? explicit : fallback;
}

function text(value) {
    if (!isSet(value)) return undefined;
    const str = makeString(value);
    return str.length > MAX_STRING ? str.substring(0, MAX_STRING) : str;
}

function decimal(value) {
    if (!isSet(value)) return undefined;
    const number = makeNumber(value);
    if (number !== number) return undefined;
    return Math.round(number * 100) / 100;
}

function count(value) {
    if (!isSet(value)) return undefined;
    const number = makeInteger(value);
    if (number !== number || number <= 0) return undefined;
    return number;
}

function currency(value) {
    const code = text(value);
    return code === undefined ? undefined : code.trim().toUpperCase();
}

function put(target, key, value) {
    if (value !== undefined) target[key] = value;
}

function readPath(item, path) {
    const segments = makeString(path).split('.');
    let current = item;
    for (let i = 0; i < segments.length; i++) {
        if (getType(current) !== 'object') return undefined;
        current = current[segments[i]];
    }
    return current;
}

function firstMatch(item, candidates) {
    for (let i = 0; i < candidates.length; i++) {
        const value = readPath(item, candidates[i]);
        if (isSet(value)) return value;
    }
    return undefined;
}

function ecommerce() {
    if (!data.autoFillFromGa4) return {};
    const dataLayerEcommerce = copyFromDataLayer('ecommerce', 2);
    if (getType(dataLayerEcommerce) !== 'object') {
        debug('auto-fill on but no ecommerce object in the data layer');
        return {};
    }
    debug('read ecommerce from data layer', dataLayerEcommerce);
    return dataLayerEcommerce;
}

function netValue(source) {
    const total = decimal(source.value);
    if (total === undefined) return undefined;
    const tax = decimal(source.tax) || 0;
    const shipping = decimal(source.shipping) || 0;
    return Math.round((total - tax - shipping) * 100) / 100;
}

function readStoredCheckoutId() {
    if (!data.linkCheckoutToOrder) return undefined;
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!isSet(raw)) return undefined;
    const stored = JSON.parse(raw);
    if (getType(stored) !== 'object' || !isSet(stored.id)) return undefined;
    if (getTimestampMillis() - makeNumber(stored.t) > CHECKOUT_ID_TTL) return undefined;
    return makeString(stored.id);
}

function writeStoredCheckoutId(id) {
    if (!data.linkCheckoutToOrder || !isSet(id)) return;
    localStorage.setItem(STORAGE_KEY, JSON.stringify({ id: id, t: getTimestampMillis() }));
}

function sourceKeys() {
    const keys = {};
    Object.keys(PRODUCT_SOURCE_KEYS).forEach(function (key) {
        keys[key] = PRODUCT_SOURCE_KEYS[key];
    });

    if (getType(data.productMapping) === 'array') {
        const overrides = makeTableMap(data.productMapping, 'mouseflowKey', 'sourceKey') || {};
        Object.keys(overrides).forEach(function (key) {
            if (keys[key] && isSet(overrides[key])) keys[key] = [makeString(overrides[key])];
        });
    }
    return keys;
}

function buildProducts(items) {
    if (getType(items) !== 'array') return undefined;

    const keys = sourceKeys();
    const mapped = [];
    let skipped = 0;

    for (let i = 0; i < items.length && mapped.length < MAX_PRODUCTS; i++) {
        const item = items[i];
        if (getType(item) !== 'object') {
            skipped++;
            continue;
        }

        const product = {};
        put(product, 'product_id', text(firstMatch(item, keys.product_id)));
        put(product, 'name', text(firstMatch(item, keys.name)));
        put(product, 'price', decimal(firstMatch(item, keys.price)));
        put(product, 'quantity', count(firstMatch(item, keys.quantity)));
        put(product, 'sku', text(firstMatch(item, keys.sku)));
        put(product, 'category', text(firstMatch(item, keys.category)));
        put(product, 'brand', text(firstMatch(item, keys.brand)));
        put(product, 'discount', decimal(firstMatch(item, keys.discount)));

        if (product.product_id === undefined || product.name === undefined ||
            product.price === undefined || product.price < 0) {
            skipped++;
            debug('dropped product, missing product_id/name/price', item);
            continue;
        }
        mapped.push(product);
    }

    if (skipped > 0 || items.length > MAX_PRODUCTS)
        debug('mapped ' + mapped.length + ' of ' + items.length + ' products');

    return mapped.length > 0 ? mapped : undefined;
}

const source = ecommerce();
const orderId = text(pick(data.orderId, source.transaction_id));
const payload = { type: data.eventType };

let checkoutId = text(data.checkoutId);
if (data.eventType === 'order-placed') {
    if (checkoutId === undefined) checkoutId = readStoredCheckoutId();
    if (checkoutId === undefined) checkoutId = text(source.transaction_id);
    if (checkoutId === undefined) checkoutId = orderId;
    if (data.linkCheckoutToOrder) localStorage.removeItem(STORAGE_KEY);

    put(payload, 'order_id', orderId);
    put(payload, 'optional_id', text(data.optionalId));
    put(payload, 'subtotal', decimal(data.subTotal));
} else {
    if (checkoutId === undefined) checkoutId = text(source.transaction_id);
    if (checkoutId === undefined) checkoutId = readStoredCheckoutId();
    if (checkoutId === undefined && data.linkCheckoutToOrder)
        checkoutId = 'mf-' + makeString(getTimestampMillis()) + '-' + makeString(generateRandom(100000, 999999));
    writeStoredCheckoutId(checkoutId);
}

put(payload, 'checkout_id', checkoutId);
put(payload, 'total', decimal(pick(data.total, source.value)));
put(payload, 'revenue', decimal(pick(data.revenue, netValue(source))));
put(payload, 'currency', currency(pick(data.currency, source.currency)));
put(payload, 'discount', decimal(data.discount));
put(payload, 'coupon', text(pick(data.coupon, source.coupon)));
put(payload, 'affiliation', text(pick(data.affiliation, source.affiliation)));
put(payload, 'products', buildProducts(pick(data.products, source.items)));

debug('pushing custom event', payload);
mfq(['addCustomEvent', payload]);
data.gtmOnSuccess();


